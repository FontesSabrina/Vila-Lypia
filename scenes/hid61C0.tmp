[sub_resource type="GDScript" id="GDScript_wxv7c"]
resource_local_to_scene = true
script/source = "extends Node2D

@export var item_mapa: ItemData

func _ready():
	# Verifica se o mapa está na cena antes de tentar conectar
	if has_node(\"CasaLinna/mapa\"):
		$CasaLinna/mapa.mapa_encontrado.connect(_on_mapa_achado)

func _on_mapa_achado():
	print(\"Sinal recebido: Mapa encontrado!\")
	
	#Salva no invetario o mapa 
	Inventario.adicionar_item(item_mapa)
	# Deixamos a barra lateral cinza 
	if has_node(\"CanvasLayer/MarginContainer/VBoxContainer/TextureRect\"):
		$CanvasLayer/MarginContainer/VBoxContainer/TextureRect.modulate = Color(0.3, 0.3, 0.3, 0.5)




func _on_michila_pressed() -> void:
	pass # Replace with function body.
"

